<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.QuickList" parent="android:Theme.Material.Light.NoActionBar">

        <item name="android:windowBackground">@color/white</item>

    </style>

    <style name="Theme.QuickList.Splash" parent="Theme.SplashScreen">
